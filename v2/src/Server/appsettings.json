{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "Data Source=istakip.db"
  },
  "Auth": {
    "Modes": ["local"],
    "CookieName": "istakip-session",
    "SessionHours": 12,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "BootstrapAdminUsername": "admin",
    "BootstrapAdminPassword": ""
  },
  "Site": {
    "AppName": "İş Takip",
    "TimeZone": "Europe/Istanbul",
    "PublicUrls": []
  },
  "Kestrel": {
    "Endpoints": {
      "Http": { "Url": "http://localhost:8080" }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
